@page
@model SIGEF.Pages.OlvideContrasenaModel
@{
    ViewData["Title"] = "Recuperar contraseña - SIGEF";
    Layout = null;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>
    <link rel="icon" type="image/png" href="~/Img/LogoSigef.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">
    <style>
            :root {
                --sigef-deep: #061a30;
                --sigef-primary: #0f4c81;
                --sigef-accent: #17c9ac;
                --sigef-accent-2: #2b8fe0;
                --sigef-ink: #0c2338;
                --sigef-muted: #7c93a8;
                --sigef-border: rgba(255,255,255,0.14);
                --sigef-danger: #ff6b6b;
            }

            * {
                box-sizing: border-box;
            }

            html, body {
                height: 100%;
                margin: 0;
                font-family: 'Manrope', 'Segoe UI', sans-serif;
            }

            body {
                min-height: 100vh;
                position: relative;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 32px;
                background: radial-gradient(ellipse at top, #0d3358 0%, #061a30 55%, #030d19 100%);
                overflow: hidden;
            }

            .sigef-glow {
                position: absolute;
                border-radius: 50%;
                filter: blur(90px);
                opacity: 0.55;
                z-index: 0;
                animation: sigef-drift 16s ease-in-out infinite;
            }

                .sigef-glow.g1 {
                    width: 620px;
                    height: 620px;
                    background: radial-gradient(circle, #17c9ac, transparent 70%);
                    top: -220px;
                    left: -160px;
                }

                .sigef-glow.g2 {
                    width: 560px;
                    height: 560px;
                    background: radial-gradient(circle, #2b8fe0, transparent 70%);
                    bottom: -240px;
                    right: -140px;
                    animation-delay: -6s;
                }

                .sigef-glow.g3 {
                    width: 380px;
                    height: 380px;
                    background: radial-gradient(circle, #6d5bd0, transparent 70%);
                    top: 40%;
                    right: 8%;
                    opacity: 0.35;
                    animation-delay: -11s;
                }

            @@keyframes sigef-drift {
                0%, 100% {
                    transform: translate(0, 0) scale(1);
                }

                50% {
                    transform: translate(40px, -30px) scale(1.08);
                }
            }

            .sigef-grid-overlay {
                position: absolute;
                inset: 0;
                background-image: linear-gradient(rgba(255,255,255,0.035) 1px, transparent 1px), linear-gradient(90deg, rgba(255,255,255,0.035) 1px, transparent 1px);
                background-size: 46px 46px;
                mask-image: radial-gradient(ellipse at center, rgba(0,0,0,0.8), transparent 75%);
                z-index: 0;
            }

            .sigef-top-bar {
                position: fixed;
                top: 26px;
                left: 0;
                right: 0;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 9px;
                font-size: 12.5px;
                font-weight: 700;
                color: rgba(255,255,255,0.65);
                letter-spacing: 1px;
                text-transform: uppercase;
                z-index: 2;
            }

                .sigef-top-bar .dot {
                    width: 6px;
                    height: 6px;
                    border-radius: 50%;
                    background: var(--sigef-accent);
                    box-shadow: 0 0 10px var(--sigef-accent);
                }

            .sigef-card {
                width: 100%;
                max-width: 420px;
                background: rgba(13, 32, 54, 0.55);
                backdrop-filter: blur(22px);
                -webkit-backdrop-filter: blur(22px);
                border: 1px solid rgba(255,255,255,0.14);
                border-radius: 24px;
                padding: 40px 38px 32px;
                box-shadow: 0 30px 70px -20px rgba(0,0,0,0.55), 0 0 0 1px rgba(255,255,255,0.03) inset;
                position: relative;
                z-index: 1;
            }

                .sigef-card::before {
                    content: "";
                    position: absolute;
                    inset: 0;
                    border-radius: 24px;
                    padding: 1px;
                    background: linear-gradient(140deg, rgba(23,201,172,0.5), rgba(255,255,255,0) 35%, rgba(43,143,224,0.4));
                    -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                    -webkit-mask-composite: xor;
                    mask-composite: exclude;
                    pointer-events: none;
                }

            .sigef-logo-circle {
                width: 84px;
                height: 84px;
                border-radius: 50%;
                margin: 0 auto 18px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(160deg, #ffffff, #dfeaf3);
                box-shadow: 0 0 0 6px rgba(23, 201, 172, 0.12), 0 0 34px rgba(23, 201, 172, 0.35), 0 10px 24px -8px rgba(0,0,0,0.4);
            }

                .sigef-logo-circle img {
                    width: 58px;
                    height: 58px;
                    object-fit: contain;
                    border-radius: 50%;
                }

            .sigef-icon-key {
                width: 60px;
                height: 60px;
                margin: 0 auto 18px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(23, 201, 172, 0.12);
                box-shadow: 0 0 0 1px rgba(23, 201, 172, 0.25);
                color: var(--sigef-accent);
            }

                .sigef-icon-key svg {
                    width: 28px;
                    height: 28px;
                }

            .sigef-title-block {
                text-align: center;
                margin-bottom: 30px;
            }

                .sigef-title-block .system-name {
                    font-size: 11.5px;
                    font-weight: 800;
                    letter-spacing: 2px;
                    color: var(--sigef-accent);
                    text-transform: uppercase;
                    margin-bottom: 8px;
                }

                .sigef-title-block h2 {
                    font-size: 22px;
                    font-weight: 800;
                    color: #fff;
                    margin: 0 0 6px;
                }

                .sigef-title-block .sub {
                    font-size: 13px;
                    color: rgba(255,255,255,0.5);
                    margin: 0;
                    line-height: 1.6;
                }

            .sigef-field {
                margin-bottom: 22px;
            }

                .sigef-field label {
                    display: block;
                    font-size: 12.5px;
                    font-weight: 700;
                    color: rgba(255,255,255,0.8);
                    margin-bottom: 7px;
                }

            .sigef-input-wrap {
                position: relative;
                display: flex;
                align-items: center;
            }

                .sigef-input-wrap .icon {
                    position: absolute;
                    left: 14px;
                    width: 18px;
                    height: 18px;
                    color: rgba(255,255,255,0.45);
                    pointer-events: none;
                }

                .sigef-input-wrap input {
                    width: 100%;
                    padding: 13px 14px 13px 42px;
                    border-radius: 12px;
                    border: 1.5px solid rgba(255,255,255,0.14);
                    font-size: 15px;
                    font-family: inherit;
                    letter-spacing: 0.5px;
                    color: #fff;
                    background: rgba(255,255,255,0.06);
                    outline: none;
                    transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
                }

                    .sigef-input-wrap input::placeholder {
                        color: rgba(255,255,255,0.35);
                        letter-spacing: normal;
                    }

                    .sigef-input-wrap input:focus {
                        border-color: var(--sigef-accent);
                        background: rgba(255,255,255,0.09);
                        box-shadow: 0 0 0 3px rgba(23, 201, 172, 0.18);
                    }

            .sigef-btn {
                width: 100%;
                padding: 13.5px;
                border: none;
                border-radius: 12px;
                background: linear-gradient(135deg, var(--sigef-accent-2), var(--sigef-accent));
                color: #04121f;
                font-size: 15px;
                font-weight: 800;
                font-family: inherit;
                cursor: pointer;
                transition: transform .12s ease, box-shadow .12s ease, filter .12s ease;
                box-shadow: 0 10px 26px -6px rgba(23, 201, 172, 0.5);
            }

                .sigef-btn:hover {
                    filter: brightness(1.08);
                    transform: translateY(-1px);
                }

                .sigef-btn:active {
                    transform: translateY(1px);
                }

            .sigef-back {
                text-align: center;
                font-size: 13px;
                color: rgba(255,255,255,0.5);
                margin-top: 20px;
            }

                .sigef-back a {
                    color: #fff;
                    font-weight: 800;
                    text-decoration: none;
                    border-bottom: 1px solid var(--sigef-accent);
                }

            .sigef-alert {
                display: none;
                align-items: center;
                gap: 8px;
                background: rgba(255,107,107,0.12);
                border: 1px solid rgba(255,107,107,0.35);
                color: #ffb3b3;
                font-size: 13px;
                font-weight: 600;
                padding: 10px 12px;
                border-radius: 10px;
                margin-bottom: 18px;
            }

            .sigef-footer {
                text-align: center;
                margin-top: 24px;
                font-size: 11px;
                color: rgba(255,255,255,0.35);
                font-weight: 600;
            }

                .sigef-footer strong {
                    color: rgba(255,255,255,0.65);
                    font-weight: 800;
                }

            @@media (max-width: 480px) {
                .sigef-card {
                    padding: 34px 24px 26px;
                }
            }
    </style>
</head>
<body>

    <div class="sigef-glow g1"></div>
    <div class="sigef-glow g2"></div>
    <div class="sigef-glow g3"></div>
    <div class="sigef-grid-overlay"></div>

    <div class="sigef-top-bar">
        <span class="dot"></span>
        SIGEF · Sistema Integral de Gestión Farmacéutica
    </div>

    <div class="sigef-card">

        <div class="sigef-icon-key">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 2 12.5 10.5" />
                <path d="M17 6a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                <path d="m9 14-6 6M9 14l2 2m-2-2 3 3m4-9-1.5-1.5" />
            </svg>
        </div>

        <div class="sigef-title-block">
            <div class="system-name">Recuperar acceso</div>
            <h2>¿Olvidaste tu contraseña?</h2>
            <p class="sub">Ingresa tu número de documento y te ayudaremos a recuperar el acceso a tu cuenta.</p>
        </div>

        <div class="sigef-alert" id="recoverAlert">
            <span>No encontramos una cuenta con ese número de documento.</span>
        </div>

        <form method="post" id="recoverForm" autocomplete="off">

            <div class="sigef-field">
                <label for="NumeroDocumento">Número de documento</label>
                <div class="sigef-input-wrap">
                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="3" y="4" width="18" height="16" rx="2" />
                        <path d="M7 8h10M7 12h6" />
                    </svg>
                    <input type="text" id="NumeroDocumento" name="NumeroDocumento" placeholder="Ej: 1023456789" inputmode="numeric" required autofocus />
                </div>
            </div>

            <button type="submit" class="sigef-btn">Recuperar</button>

            <div class="sigef-back">
                <a href="/Index">← Volver a iniciar sesión</a>
            </div>

        </form>

        <div class="sigef-footer">
            Desarrollado por <strong>Jhan Estrada</strong>
        </div>

    </div>

</body>
</html>

